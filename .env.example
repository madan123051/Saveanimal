PORT=3000

# Firebase Admin/server config
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Firebase browser config. Firebase web apiKey is public by design, but keep it out of source.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_DATABASE_URL=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
ADMIN_EMAIL=

# Map config. If MAP_TILE_URL_TEMPLATE is empty, the app uses Esri satellite tiles.
# For providers that require a key, use {key} where the key belongs in the tile URL.
MAP_API_KEY=
MAP_TILE_URL_TEMPLATE=
MAP_ATTRIBUTION=

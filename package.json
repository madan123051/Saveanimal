{
  "name": "saveanimal-nepal",
  "version": "1.0.0",
  "description": "SaveAnimal Nepal NGO-style website with frontend and backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm run build:dashboard && npm run start",
    "build:dashboard": "esbuild dashboard/app.tsx --bundle --outfile=dashboard/bundle.js --platform=browser --jsx=automatic --external:lucide-react --external:react --external:react-dom"
  },
  "dependencies": {
    "express": "^4.19.2",
    "firebase-admin": "^12.0.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.0",
    "lucide-react": "^0.408.0",
    "typescript": "^5.4.5"
  }
}
